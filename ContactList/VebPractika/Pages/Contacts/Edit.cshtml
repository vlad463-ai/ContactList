@page
@model ContactList.Pages.Contacts.EditModel
@{
    ViewData["Title"] = "Редактировать контакт";
}

<h1>Редактировать контакт</h1>

<form method="post">
    <input type="hidden" asp-for="Contact.Id" />

    <div>
        <label>ФИО</label><br />
        <input asp-for="Contact.FIO" />
        <span asp-validation-for="Contact.FIO"></span>
    </div>

    <div>
        <label>Email</label><br />
        <input asp-for="Contact.Email" type="email" />
        <span asp-validation-for="Contact.Email"></span>
    </div>

    <div>
        <label>Телефон</label><br />
        <input asp-for="Contact.Phone" />
    </div>

    <div>
        <label>Категория</label><br />
        <select asp-for="Contact.CategoryId" asp-items="@(ViewData["CategoryId"] as SelectList)">
            <option value="">-- Выберите категорию --</option>
        </select>
    </div>

    <button type="submit">Сохранить</button>
</form>

<a asp-page="Index">Назад</a>