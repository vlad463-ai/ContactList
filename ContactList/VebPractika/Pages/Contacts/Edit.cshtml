@page
@model ContactList.Pages.Contacts.EditModel
@{
    ViewData["Title"] = "Редактировать контакт";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-warning text-dark">
                    <h3 class="mb-0">✏️ Редактировать контакт</h3>
                </div>
                <div class="card-body">
                    <form method="post">
                        <input type="hidden" asp-for="Contact.Id" />

                        <div class="mb-3">
                            <label class="form-label fw-bold">ФИО</label>
                            <input asp-for="Contact.FIO" class="form-control" />
                            <span asp-validation-for="Contact.FIO" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Email</label>
                            <input asp-for="Contact.Email" type="email" class="form-control" />
                            <span asp-validation-for="Contact.Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Телефон</label>
                            <input asp-for="Contact.Phone" class="form-control" />
                            <span asp-validation-for="Contact.Phone" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Категория</label>
                            <select asp-for="Contact.CategoryId" class="form-select" asp-items="@(ViewData["CategoryId"] as SelectList)">
                                <option value="">-- Выберите категорию --</option>
                            </select>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <button type="submit" class="btn btn-primary">💾 Сохранить</button>
                            <a asp-page="Index" class="btn btn-secondary">🔙 Назад</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>