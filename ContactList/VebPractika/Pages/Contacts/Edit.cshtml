@page "{id:int}"
@model ContactList.Pages.Contacts.EditModel
@{
}

<h1>Редактировать контакт</h1>

<form method="post">
    <input type="hidden" asp-for="Contacts.Id" />

    <div>
        <label>ФИО</label><br />
        <input asp-for="Contacts.FIO" />
        <span asp-validation-for="Contacts.FIO"></span>
    </div>

    <div>
        <label>Email</label><br />
        <input asp-for="Contacts.email" type="email" />
        <span asp-validation-for="Contacts.email"></span>
    </div>

    <div>
        <label>Телефон</label><br />
        <input asp-for="Contacts.Phone" />
    </div>

    <div>
        <label>Категория</label><br />
        <select asp-for="Contacts.CategoryId" asp-items="ViewBag.CategoryId">
            <option value="">-- Выберите категорию --</option>
        </select>
    </div>

    <button type="submit">Сохранить</button>
</form>

<a asp-page="Index">Назад к списку</a>