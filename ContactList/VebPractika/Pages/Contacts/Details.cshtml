@page
@model ContactList.Pages.Contacts.DetailsModel
@{
    ViewData["Title"] = "Детали контакта";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-info text-white">
                    <h3 class="mb-0">📄 Детали контакта</h3>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">ФИО</label>
                        <p>@Model.Contact.FIO</p>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Email</label>
                        <p>@Model.Contact.Email</p>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Телефон</label>
                        <p>@Model.Contact.Phone</p>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Категория</label>
                        <p>@(Model.Contact.Category?.Name ?? "—")</p>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-page="Edit" asp-route-id="@Model.Contact.Id" class="btn btn-warning">✏️ Редактировать</a>
                        <a asp-page="Index" class="btn btn-secondary">🔙 Назад</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
