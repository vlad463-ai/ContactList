@page
@model ContactList.Pages.Contacts.DetailsModel
@{
    ViewData["Title"] = "Детали контакта";
}

<h1>Детали контакта</h1>

<div>
    <dl class="row">
        <dt class="col-sm-2">ФИО</dt>
        <dd class="col-sm-10">@Model.Contact.FIO</dd>

        <dt class="col-sm-2">Email</dt>
        <dd class="col-sm-10">@Model.Contact.email</dd>

        <dt class="col-sm-2">Телефон</dt>
        <dd class="col-sm-10">@Model.Contact.Phone</dd>

        <dt class="col-sm-2">Категория</dt>
        <dd class="col-sm-10">
            @if (Model.Contact.Category != null)
            {
                @Model.Contact.Category.Name
            }
            else
            {
                <span class="text-muted">—</span>
            }
        </dd>
    </dl>
</div>

<div>
    <a asp-page="Edit" asp-route-id="@Model.Contact.Id" class="btn btn-warning">Редактировать</a>
    <a asp-page="Index" class="btn btn-secondary">Назад</a>
</div>