@page "{id:int}"
@model ContactList.Pages.Contacts.DeleteModel
@{
}

<h1>Удалить контакт</h1>

<h3>Вы уверены, что хотите удалить этот контакт?</h3>

<div>
    <p><strong>@Model.Contact.FIO</strong></p>
    <p>Email: @Model.Contact.email</p>
    <p>Телефон: @Model.Contact.Phone</p>
</div>

<form method="post">
    <input type="hidden" asp-for="Contact.Id" />
    <button type="submit">Удалить</button>
</form>

<a asp-page="Index">Отмена</a>