@page
@model ContactList.Pages.Contacts.DeleteModel
@{
    ViewData["Title"] = "Удалить контакт";
}

<h1>Удалить контакт</h1>

<div class="alert alert-danger">
    <h3>Вы уверены, что хотите удалить этот контакт?</h3>
</div>

<div>
    <dl class="row">
        <dt class="col-sm-2">ФИО</dt>
        <dd class="col-sm-10">@Model.Contact.FIO</dd>

        <dt class="col-sm-2">Email</dt>
        <dd class="col-sm-10">@Model.Contact.Email</dd>

        <dt class="col-sm-2">Телефон</dt>
        <dd class="col-sm-10">@Model.Contact.Phone</dd>

        <dt class="col-sm-2">Категория</dt>
        <dd class="col-sm-10">
            @if (Model.Contact.Category != null)
            {
                @Model.Contact.Category.Name
            }
            else
            {
                <span class="text-muted">—</span>
            }
        </dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Contact.Id" />
        <input type="submit" value="Удалить" class="btn btn-danger" />
        <a asp-page="Index" class="btn btn-secondary">Назад</a>
    </form>
</div>