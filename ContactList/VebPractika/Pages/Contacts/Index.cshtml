@page
@model ContactList.Pages.Contacts.IndexModel
@{
    ViewData["Title"] = "Контакты";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>📋 Контакты</h1>
        <a asp-page="Create" class="btn btn-primary">➕ Добавить контакт</a>
    </div>

    <div class="row">
        @foreach (var item in Model.Contacts)
        {
            <div class="col-md-4 mb-3">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">@item.FIO</h5>
                        <p class="card-text mb-1">
                            <strong>Email:</strong> @item.Email<br />
                            <strong>Телефон:</strong> @item.Phone<br />
                            <strong>Категория:</strong>
                            @if (item.Category != null)
                            {
                                <span class="badge" style="background-color: @item.Category.Color">@item.Category.Name</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </p>
                        <div class="btn-group w-100 mt-2">
                            <a asp-page="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Открыть</a>
                            <a asp-page="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Изменить</a>
                            <a asp-page="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Удалить</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>