@page
@model ContactList.Pages.Contacts.IndexModel
@{
    ViewData["Title"] = "Контакты";
}

<h2>Контакты</h2>

<div class="container mt-4">

    <!-- Заголовок и кнопка добавления контакта -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Список контактов</h2>
        <a asp-page="Create" class="btn btn-success">
            Добавить новый контакт
        </a>
    </div>

    <!-- Плитки контактов -->
    <div class="row g-4">
        @foreach (var contact in Model.Contacts)
        {
            <!-- Каждая карточка контакта в колонке -->
            <div class="col-sm-6 col-md-4 col-lg-3">

                <!-- Карточка контакта с тенью -->
                <div class="card h-100 shadow-sm" id="contact-@contact.Id">
                    <div class="card-body">

                        <!-- Заголовок с ФИО и иконкой -->
                        <h5 class="card-title text-truncate">
                            👤 @contact.FIO
                        </h5>

                        <!-- Email -->
                        <p class="card-text text-muted mb-1">
                            Email: @contact.email
                        </p>

                        <!-- Телефон -->
                        <p class="card-text mb-2">
                            Телефон: <span class="badge bg-secondary">@contact.Phone</span>
                        </p>

                        <!-- Кнопки действий -->
                        <div class="d-flex justify-content-between">
                            <a asp-page="Details" asp-route-id="@contact.Id" class="btn btn-sm btn-info">
                                Открыть
                            </a>
                            <a asp-page="Edit" asp-route-id="@contact.Id" class="btn btn-sm btn-warning">
                                Изменить
                            </a>
                            <a asp-page="Delete" asp-route-id="@contact.Id" class="btn btn-sm btn-danger">
                                Удалить
                            </a>
                        </div>

                    </div>
                </div>

            </div>
        }
    </div>

</div>