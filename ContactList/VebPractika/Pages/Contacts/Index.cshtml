@page
@model ContactList.Pages.Contacts.IndexModel
@{
    ViewData["Title"] = "Контакты";
}

<h1>Контакты</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">➕ Добавить контакт</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ФИО</th>
            <th>Email</th>
            <th>Телефон</th>
            <th>Категория</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Contacts)
        {
            <tr>
                <td>@item.FIO</td>
                <td>@item.email</td>
                <td>@item.Phone</td>
                <td>
                    @if (item.Category != null)
                    {
                        @item.Category.Name
                    }
                    else
                    {
                        <span class="text-muted">—</span>
                    }
                </td>
                <td>
                    <a asp-page="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">📄 Детали</a>
                    <a asp-page="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">✏️ Изменить</a>
                    <a asp-page="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">🗑️ Удалить</a>
                </td>
            </tr>
        }
    </tbody>
</table>