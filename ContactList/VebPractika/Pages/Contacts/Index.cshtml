@page
@model ContactList.Pages.Contacts.IndexModel
@{
}

<h1>Список контактов</h1>

<p>
    <a asp-page="Create">Добавить контакт</a>
</p>

<table border="1" cellpadding="5">
    <thead>
        <tr>
            <th>ФИО</th>
            <th>Email</th>
            <th>Телефон</th>
            
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var student in Model.Contacts)
        {
            <tr>
                <td>@student.FIO</td>
                <td>@student.email</td>
                <td>@student.Phone</td>
       
                <td>
                    <a asp-page="Details" asp-route-id="@student.Id">Открыть</a>
                    <a asp-page="Edit" asp-route-id="@student.Id">Изменить</a>
                    <a asp-page="Delete" asp-route-id="@student.Id">Удалить</a>
                </td>
            </tr>
        }
    </tbody>
</table>
﻿

