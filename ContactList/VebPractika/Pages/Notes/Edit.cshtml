@page
@model ContactList.Pages.Notes.EditModel
@{
    ViewData["Title"] = "Редактировать заметку";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-warning text-dark">
                    <h3 class="mb-0">Редактировать заметку</h3>
                </div>
                <div class="card-body">
                    <form method="post">
                        <input type="hidden" asp-for="Note.Id" />

                        <div class="mb-3">
                            <label class="form-label fw-bold">Текст заметки</label>
                            <textarea asp-for="Note.Text" class="form-control" rows="5"></textarea>
                            <span asp-validation-for="Note.Text" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Контакт</label>
                            <select asp-for="Note.ContactId" class="form-select" asp-items="@(ViewData["ContactId"] as SelectList)">
                                <option value="">-- Выберите контакт --</option>
                            </select>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <button type="submit" class="btn btn-primary">Сохранить</button>
                            <a asp-page="Index" class="btn btn-secondary">Назад</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>