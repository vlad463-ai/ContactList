@page
@model ContactList.Pages.Categories.CreateModel

@{
    ViewData["Title"] = "Добавить категорию";
}

<h1>Добавить категорию</h1>

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="Category.Name" class="control-label">Название категории</label>
                <input asp-for="Category.Name" class="form-control" />
                <span asp-validation-for="Category.Name" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Category.Color" class="control-label">Цвет</label>
                <input asp-for="Category.Color" class="form-control" type="color" />
                <span asp-validation-for="Category.Color" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Сохранить" class="btn btn-primary" />
                <a asp-page="Index" class="btn btn-secondary">Назад</a>
            </div>
        </form>
    </div>
</div>