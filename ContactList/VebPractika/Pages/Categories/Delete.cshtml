@page
@model ContactList.Pages.Categories.DeleteModel

@{
    ViewData["Title"] = "Удалить категорию";
}

<h1>Удалить категорию</h1>

<div class="alert alert-danger">
    <h3>Вы уверены, что хотите удалить эту категорию?</h3>
</div>

<div>
    <dl class="row">
        <dt class="col-sm-2">
            Название
        </dt>
        <dd class="col-sm-10">
            @Model.Category.Name
        </dd>
        <dt class="col-sm-2">
            Цвет
        </dt>
        <dd class="col-sm-10">
            <span style="display:inline-block; width:30px; height:30px; background-color:@Model.Category.Color;"></span>
            @Model.Category.Color
        </dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Category.Id" />
        <input type="submit" value="Удалить" class="btn btn-danger" />
        <a asp-page="Index" class="btn btn-secondary">Назад</a>
    </form>
</div>