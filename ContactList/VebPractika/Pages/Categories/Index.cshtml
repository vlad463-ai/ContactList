@page
@model ContactList.Pages.Categories.IndexModel

@{
    ViewData["Title"] = "Категории";
}

<h1>Категории</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">➕ Добавить категорию</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Название</th>
            <th>Цвет</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Categories)
        {
            <tr>
                <td>@item.Name</td>
                <td>
                    <span style="display:inline-block; width:30px; height:30px; background-color:@item.Color; border:1px solid #ddd; border-radius:4px;"></span>
                    @item.Color
                </td>
                <td>
                    <a asp-page="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">✏️ Ред</a>
                    <a asp-page="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">🗑️ Удалить</a>
                </td>
            </tr>
        }
    </tbody>
</table>