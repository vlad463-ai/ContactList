@page
@model ContactList.Pages.Categories.DetailsModel
@{
    ViewData["Title"] = "Детали категории";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-info text-white">
                    <h3 class="mb-0">📄 Детали категории</h3>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Название</label>
                        <p>@Model.Category.Name</p>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Цвет</label>
                        <p>
                            <span style="display:inline-block; width:30px; height:30px; background-color:@Model.Category.Color; border-radius:4px;"></span>
                            @Model.Category.Color
                        </p>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-page="Edit" asp-route-id="@Model.Category.Id" class="btn btn-warning">✏️ Редактировать</a>
                        <a asp-page="Index" class="btn btn-secondary">🔙 Назад</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
